{
  "name": "hongslab",
  "main": "worker.js",
  "compatibility_date": "2025-01-01",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hongslab-db",
      "database_id": "ff8469d1-609d-4e7c-bd8c-3cd62b5c1039",
      "migrations_dir": "migrations"
    }
  ],
  "unsafe": {
    "bindings": [
      { "name": "SEO_LIMIT", "type": "ratelimit", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } },
      { "name": "LOGIN_LIMIT", "type": "ratelimit", "namespace_id": "1002", "simple": { "limit": 5, "period": 60 } },
      { "name": "TRACK_LIMIT", "type": "ratelimit", "namespace_id": "1003", "simple": { "limit": 60, "period": 60 } }
    ]
  }
}
